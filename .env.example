# Database Configuration (Supabase PostgreSQL 15 or local SQLite fallback)
DATABASE_URL=sqlite:///./techpulse.db
# DATABASE_URL=postgresql://postgres:[PASSWORD]@db.[REF].supabase.co:5432/postgres

# Redis Configuration (Upstash Redis 7 or local Redis)
REDIS_URL=redis://localhost:6379/0
# REDIS_URL=rediss://default:[TOKEN]@glowing-locust-12345.upstash.io:6379

# LLM & External API Keys
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
ANTHROPIC_API_KEY=
GITHUB_PAT=
SEMANTIC_SCHOLAR_API_KEY=

# App Environment
ENVIRONMENT=development
LOG_LEVEL=INFO
CORS_ORIGINS=["http://localhost:5173", "http://localhost:3000", "http://127.0.0.1:5173"]
