# ─── TechPulse AI (ATIP) Production Environment Template ───

# 1. Database (Supabase PostgreSQL 15 or Managed Postgres)
# Replace [PASSWORD] and [PROJECT_REF] with your Supabase values
DATABASE_URL=postgresql://postgres:[PASSWORD]@db.[PROJECT_REF].supabase.co:5432/postgres

# 2. Redis & Celery Message Broker (Upstash Serverless Redis)
# Replace [TOKEN] and [ENDPOINT] with your Upstash values
REDIS_URL=rediss://default:[TOKEN]@[ENDPOINT].upstash.io:6379
REDIS_FEED_CACHE_TTL=300

# 3. LLM API Keys (For Stage 5 AI Synthesis)
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b
ANTHROPIC_API_KEY=sk-ant-your_anthropic_api_key_here

# 4. External Data Source Credentials
GITHUB_PAT=ghp_your_personal_access_token_here
SEMANTIC_SCHOLAR_API_KEY=your_semantic_scholar_api_key_here

# 5. Production Application Settings
ENVIRONMENT=production
DEBUG=False
LOG_LEVEL=INFO

# 6. CORS Allowed Origins (Comma-separated or JSON list)
CORS_ORIGINS=["https://techpulse-ai.vercel.app", "http://localhost:5173"]

